{{- /*
The authentik objects a TestCase's dependencies need, for one target
(see dependencyBlueprint). Verified against authentik's own source
(blueprints/testing/oidc-conformance.yaml,
authentik/providers/{oauth2,saml}/models.py,
authentik/sources/{oauth,saml}/models.py and their API serializers). Every
object keys on name/slug and every secret is a literal attr, so re-applying
it every reconcile is an idempotent update rather than drift. Flows and the
signing keypair are authentik's own defaults, seeded by its always-applied
blueprints/default/*.yaml.
*/ -}}
version: 1
entries:
{{- with .OIDCClient }}
  # OAuth2Provider + Application oidc-test-client logs in through. The scope
  # mappings match what oidc-test-client requests by default (OIDC_SCOPES);
  # "scope-profile" is the managed name blueprints/system/providers-oauth2.yaml
  # seeds, not oidc-conformance.yaml's "scope-profile-oidc-standard".
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ .ID | quote }}
    identifiers:
      name: {{ .ID | quote }}
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: {{ .ID | quote }}
      client_secret: {{ .Secret | quote }}
      redirect_uris:
        - matching_mode: strict
          url: {{ .RedirectURI | quote }}
          redirect_uri_type: authorization
      grant_types:
        - authorization_code
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-openid]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-email]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-profile]]
        - !Find [authentik_providers_oauth2.scopemapping, [managed, goauthentik.io/providers/oauth2/scope-offline_access]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
  - model: authentik_core.application
    identifiers:
      slug: {{ .ID | quote }}
    attrs:
      provider: !KeyOf {{ .ID | quote }}
      name: {{ .ID | quote }}
{{- end }}
{{- with .SAMLClient }}
  # SAMLProvider + Application saml-test-sp logs in through. The SP's entity
  # ID doubles as the audience, which crewjam/saml checks. sp_binding is post:
  # saml-test-sp's ACS only takes HTTP-POST. sign_assertion is the model
  # default, but the serializer rejects a signing_kp without sign_assertion or
  # sign_response in the submitted attrs (seen on authentik 2026.8).
  - model: authentik_providers_saml.samlprovider
    id: {{ .ID | quote }}
    identifiers:
      name: {{ .ID | quote }}
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      acs_url: {{ .ACSURL | quote }}
      audience: {{ .Audience | quote }}
      sp_binding: post
      signing_kp: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      sign_assertion: true
      property_mappings:
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/uid]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/username]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/email]]
        - !Find [authentik_providers_saml.samlpropertymapping, [managed, goauthentik.io/providers/saml/name]]
  - model: authentik_core.application
    identifiers:
      slug: {{ .ID | quote }}
    attrs:
      provider: !KeyOf {{ .ID | quote }}
      name: {{ .ID | quote }}
{{- end }}
{{- with .OIDCSource }}
  # OAuth source federating to dex. Endpoints are explicit rather than
  # oidc_well_known_url: the serializer fetches that (and the JWKS) during
  # validation, which fails while dex isn't up yet - and dex only starts once
  # this blueprint has been applied.
  - model: authentik_sources_oauth.oauthsource
    identifiers:
      slug: {{ .Slug | quote }}
    attrs:
      name: {{ .Slug | quote }}
      provider_type: openidconnect
      consumer_key: {{ .Slug | quote }}
      consumer_secret: {{ .Secret | quote }}
      authorization_url: {{ printf "%s/auth" .IssuerURL | quote }}
      access_token_url: {{ printf "%s/token" .IssuerURL | quote }}
      profile_url: {{ printf "%s/userinfo" .IssuerURL | quote }}
      authentication_flow: !Find [authentik_flows.flow, [slug, default-source-authentication]]
      enrollment_flow: !Find [authentik_flows.flow, [slug, default-source-enrollment]]
{{- end }}
{{- with .SAMLSource }}
  # SAML source federating to saml-test-idp. No verification_kp: saml-test-idp
  # generates a fresh signing keypair on every start, and authentik only
  # verifies signatures when one is set. name_id_policy stays the default
  # (persistent), which saml-test-idp answers with the plain username.
  - model: authentik_sources_saml.samlsource
    identifiers:
      slug: {{ .Slug | quote }}
    attrs:
      name: {{ .Slug | quote }}
      sso_url: {{ .SSOURL | quote }}
      binding_type: REDIRECT
      pre_authentication_flow: !Find [authentik_flows.flow, [slug, default-source-pre-authentication]]
      authentication_flow: !Find [authentik_flows.flow, [slug, default-source-authentication]]
      enrollment_flow: !Find [authentik_flows.flow, [slug, default-source-enrollment]]
{{- end }}
{{- with .OAuthToken }}
  # Two OAuth2Provider + Application pairs k6 drives at the token endpoint,
  # with no relying party in front: the first issues client_credentials
  # tokens (to the provider's generated service account), the second
  # exchanges those for its own (RFC 8693), trusting the first through
  # jwt_federation_providers.
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ .ID | quote }}
    identifiers:
      name: {{ .ID | quote }}
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: {{ .ID | quote }}
      client_secret: {{ .Secret | quote }}
      # Required by the serializer even without a browser flow.
      redirect_uris: []
      grant_types:
        - client_credentials
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
  - model: authentik_core.application
    identifiers:
      slug: {{ .ID | quote }}
    attrs:
      provider: !KeyOf {{ .ID | quote }}
      name: {{ .ID | quote }}
  - model: authentik_providers_oauth2.oauth2provider
    id: {{ .ExchangeID | quote }}
    identifiers:
      name: {{ .ExchangeID | quote }}
    attrs:
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      client_type: confidential
      client_id: {{ .ExchangeID | quote }}
      client_secret: {{ .ExchangeSecret | quote }}
      # Required by the serializer even without a browser flow.
      redirect_uris: []
      grant_types:
        - "urn:ietf:params:oauth:grant-type:token-exchange"
      jwt_federation_providers:
        - !KeyOf {{ .ID | quote }}
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
  - model: authentik_core.application
    identifiers:
      slug: {{ .ExchangeID | quote }}
    attrs:
      provider: !KeyOf {{ .ExchangeID | quote }}
      name: {{ .ExchangeID | quote }}
{{- end }}
