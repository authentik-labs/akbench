[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
command -v kubectl >/dev/null 2>&1 || return 0
eval "$(kubectl completion bash)"

# Give every kubectl alias above kubectl's own completion: rewrite the line as
# if the alias were typed out (resolving aliases of aliases, e.g.
# kgpw -> kgp --watch) and hand off to __start_kubectl.
__bench_alias_complete() {
  local name=${COMP_WORDS[0]} exp=${BASH_ALIASES[${COMP_WORDS[0]}]} first
  first=${exp%% *}
  while [ "$first" != kubectl ] && [ -n "${BASH_ALIASES[$first]}" ]; do
    exp=${BASH_ALIASES[$first]}${exp#"$first"}
    first=${exp%% *}
  done
  [ "$first" = kubectl ] || return
  local -a pre
  read -ra pre <<<"$exp"
  COMP_LINE=$exp${COMP_LINE#"$name"}
  COMP_POINT=$((COMP_POINT + ${#exp} - ${#name}))
  COMP_WORDS=("${pre[@]}" "${COMP_WORDS[@]:1}")
  COMP_CWORD=$((COMP_CWORD + ${#pre[@]} - 1))
  __start_kubectl
}
complete -o default -F __bench_alias_complete $(compgen -a)

# kubectx/kubens release tarballs ship no completion scripts.
__bench_kubectx_complete() {
  COMPREPLY=($(compgen -W "- $(kubectl config get-contexts -o name 2>/dev/null)" -- "${COMP_WORDS[COMP_CWORD]}"))
}
__bench_kubens_complete() {
  COMPREPLY=($(compgen -W "- $(kubectl get namespaces -o name 2>/dev/null | sed 's|^namespace/||')" -- "${COMP_WORDS[COMP_CWORD]}"))
}
complete -F __bench_kubectx_complete kubectx
complete -F __bench_kubens_complete kubens
