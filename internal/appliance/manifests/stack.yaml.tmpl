# Rendered by internal/appliance.RenderStack and server-side applied by
# cmd/appliance on every boot, after Flux and the Cluster API providers are
# up (the operator watches CAPI/Flux types and won't start without their
# CRDs). Every string value goes through toJSON - JSON strings are valid
# YAML scalars, so tokens can't break the document.
#
# Nothing here is specific to any infrastructure provider: which providers
# get installed and their connection settings are chosen in the web UI.
apiVersion: v1
kind: Namespace
metadata:
  name: authentik-bench
---
apiVersion: v1
kind: Secret
metadata:
  name: apiserver-token
  namespace: authentik-bench
type: Opaque
stringData:
  token: {{ toJSON .State.APIToken }}
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: authentik-bench-operator
  namespace: flux-system
spec:
  interval: 10m
  url: {{ toJSON .Config.OperatorChart }}
  ref:
    tag: {{ toJSON .Version }}
  layerSelector:
    mediaType: application/vnd.cncf.helm.chart.content.v1.tar+gzip
    operation: copy
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: authentik-bench-operator
  namespace: flux-system
spec:
  interval: 10m
  releaseName: authentik-bench-operator
  targetNamespace: authentik-bench
  chartRef:
    kind: OCIRepository
    name: authentik-bench-operator
  install:
    remediation:
      retries: -1
  upgrade:
    remediation:
      retries: 3
  values:
    controllerManager:
      manager:
        image:
          repository: {{ toJSON .Config.OperatorImage }}
          tag: {{ toJSON .Version }}
        # Where the operator seeds the built-in TestCaseTemplates; must match
        # the apiserver's BENCH_NAMESPACE below.
        env:
          benchNamespace: {{ toJSON .Config.Namespace }}
        resources:
          limits:
            cpu: "1"
            memory: 1Gi
          requests:
            cpu: 50m
            memory: 128Mi
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: apiserver
  namespace: authentik-bench
---
# cluster-admin: the kubectl shell hands out the merged kubeconfig and the API
# CRUDs every akbench CRD - same posture as hack/dev-apiserver.yaml.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: authentik-bench-apiserver
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
  - kind: ServiceAccount
    name: apiserver
    namespace: authentik-bench
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: apiserver
  namespace: authentik-bench
  labels:
    app: authentik-bench-apiserver
spec:
  replicas: 1
  selector:
    matchLabels:
      app: authentik-bench-apiserver
  template:
    metadata:
      labels:
        app: authentik-bench-apiserver
    spec:
      serviceAccountName: apiserver
      containers:
        - name: apiserver
          image: {{ toJSON (printf "%s:%s" .Config.APIServerImage .Version) }}
          env:
            - name: BENCH_NAMESPACE
              value: {{ toJSON .Config.Namespace }}
            # Lets the web UI enable infrastructure providers: it writes the
            # appliance's provider ConfigMap, which cmd/appliance's provider
            # loop installs with clusterctl (internal/appliance/providers.go).
            - name: BENCH_APPLIANCE
              value: "true"
            # Lets the web UI update akbench to the latest published build:
            # it looks the version up from this image's :latest tag and pins
            # it, against the appliance image's own version, in
            # VersionConfigMap (internal/appliance/providers.go).
            - name: BENCH_APPLIANCE_IMAGE
              value: {{ toJSON .Config.APIServerImage }}
            - name: BENCH_APPLIANCE_VERSION
              value: {{ toJSON .Config.Version }}
            - name: BENCH_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: apiserver-token
                  key: token
            # Must match the operator's BENCH_SHELL_KUBECONFIG_NAMESPACE/
            # BENCH_SHELL_KUBECONFIG_SECRET_NAME defaults (cmd/main.go).
            - name: BENCH_SHELL_KUBECONFIG_SECRET
              value: authentik-bench/shell-kubeconfig
{{- with .Config.OIDCIssuer }}
            - name: BENCH_OIDC_ISSUER
              value: {{ toJSON . }}
{{- end }}
{{- with .Config.OIDCClientID }}
            - name: BENCH_OIDC_CLIENT_ID
              value: {{ toJSON . }}
{{- end }}
{{- with .Config.OIDCScopes }}
            - name: BENCH_OIDC_SCOPES
              value: {{ toJSON . }}
{{- end }}
{{- with .Config.OIDCRequiredGroup }}
            - name: BENCH_OIDC_REQUIRED_GROUP
              value: {{ toJSON . }}
{{- end }}
          ports:
            - name: https
              containerPort: 8443
          readinessProbe:
            httpGet:
              path: /healthz
              port: https
              scheme: HTTPS
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
---
# k3s's ServiceLB binds the LoadBalancer port on the node - the appliance
# container itself - so `docker run -p {{ .Config.UIPort }}:{{ .Config.UIPort }}` reaches it.
apiVersion: v1
kind: Service
metadata:
  name: apiserver
  namespace: authentik-bench
spec:
  type: LoadBalancer
  selector:
    app: authentik-bench-apiserver
  ports:
    - name: https
      port: {{ .Config.UIPort }}
      targetPort: https
